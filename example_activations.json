  "usage_instructions": {
    "browser": [
      "1. Open htm_transformer_sim_ordis.html in browser",
      "2. Open DevTools console (F12)",
      "3. Run: fetch('example_activations.json').then(r => r.json()).then(data => window.HTMIntegration.loadActivations(data))",
