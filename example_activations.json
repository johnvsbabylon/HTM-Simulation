    "python_generation": [
      "# To generate this from real model:",
      "from transformer_lens import HookedTransformer",
      "import json",
      "import numpy as np",
      "",
      "model = HookedTransformer.from_pretrained('gpt2-small')",
      "tokens = model.to_tokens('The cat sat on the')",
      "logits, cache = model.run_with_cache(tokens)",
      "",
      "data = {",
      "    'metadata': {",
      "        'model_name': model.cfg.model_name,",
      "        'n_layers': model.cfg.n_layers,",
      "        'd_model': model.cfg.d_model,",
      "        'n_heads': model.cfg.n_heads,",
      "        'seq_len': tokens.shape[1]",
      "    },",
      "    'layers': []",
      "}",
      "",
      "for l in range(model.cfg.n_layers):",
      "    resid = cache['resid_post', l].squeeze().cpu().numpy()",
      "    ",
      "    # Compute SVD",
      "    U, S, Vt = np.linalg.svd(resid, full_matrices=False)",
      "    ",
      "    # Entropy from eigenvalue distribution",
      "    p = S / S.sum()",
      "    entropy = -np.sum(p * np.log(p + 1e-10))",
      "    ",
      "    data['layers'].append({",
      "        'layer_idx': l,",
      "        'eigenvalues': {",
      "            'top_10': S[:10].tolist(),",
      "            'entropy': float(entropy)",
      "        },",
      "        'residual_stats': {",
      "            'mean': float(resid.mean()),",
      "            'std': float(resid.std()),",
      "            'norm': float(np.linalg.norm(resid))",
      "        }",
      "    })",
      "",
      "with open('activations.json', 'w') as f:",
      "    json.dump(data, f, indent=2)"
    ]
  },
  "notes": [
    "This is EXAMPLE data showing the expected format.",
    "Real transformer activations will have different values.",
    "Eigenvalues should generally increase with layer depth (growing representation power).",
    "Entropy typically increases then collapses at recognition.",
    "For full residual streams, use WebSocket streaming instead of JSON.",
    "JSON format good for: small models, single forward passes, analysis.",
    "WebSocket format good for: large models, real-time generation, interaction."
